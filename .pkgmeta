# BigWigsMods/packager configuration.
#
# package-as sets the folder name INSIDE the release zip. It must match the
# addon folder name WoW expects (and the .toc filename), not the repo name —
# a zip that unpacks to "Postbox-main/" would not load.
package-as: Postbox

# Dev-only files: useful in the repo, dead weight in the shipped addon.
#
# Gitignored is NOT enough on its own: .dev/ is ignored but two of its files are
# also tracked, so they were in the checkout the packager runs against and were
# shipping to players. Anything that must not reach the zip is listed here.
#
# What ships, verified against the built artifact rather than assumed:
# Core/, Lib/, Media/, Postbox.toc, Postbox.lua, LICENSE and CHANGELOG.md.
ignore:
  - .github
  - .dev
  - CLAUDE.md
  - README.md
  - COMBAT_TAINT.md
  - ELLESMEREUI_SKINNING.md
  - docs

# The changelog CurseForge, Wago and the GitHub release show: the newest five
# versions and a link to the full CHANGELOG.md on GitHub. The release workflow
# writes it from CHANGELOG.md just before the packager runs
# (.github/release-changelog.py), so the repo only ever holds one changelog.
#
# The packager reads a manual changelog from the checkout (from the package
# only if a copy landed there), and naming a file here does not keep it out of
# the zip: it is even exempt from the rule that leaves untracked files behind.
# So this one lives under .github, which never reaches the zip: the packager
# skips every dot-folder, and .github is ignored above as well. The full
# CHANGELOG.md does ship, deliberately: it is written for players, so it is
# worth having where a player can find it.
#
# Run the packager by hand and this file has to be written first. Without it
# the packager falls back to a changelog of commits, and writes that over the
# CHANGELOG.md in the package.
manual-changelog:
  filename: .github/release-changelog.md
  markup-type: markdown
