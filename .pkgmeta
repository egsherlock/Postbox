# BigWigsMods/packager configuration.
#
# package-as sets the folder name INSIDE the release zip. It must match the
# addon folder name WoW expects (and the .toc filename), not the repo name —
# a zip that unpacks to "Postbox-main/" would not load.
package-as: Postbox

# Dev-only files: useful in the repo, dead weight in the shipped addon.
#
# Only TRACKED files need listing. Anything gitignored is already absent from
# the checkout the packager runs against, so naming it here would be redundant.
#
# What ships, verified against the built artifact rather than assumed:
# Core/, Lib/, Media/, Postbox.toc, Postbox.lua, LICENSE and CHANGELOG.md.
ignore:
  - .github
  - README.md
  - COMBAT_TAINT.md
  - ELLESMEREUI_SKINNING.md
  - docs

# Nominates the changelog for the release page and the CurseForge/Wago upload.
#
# It also ships inside the addon folder, which is deliberate: it is written for
# players rather than developers, so it is worth having where a player can find
# it. (An earlier note here claimed this kept it out of the zip. It never did —
# manual-changelog names the file, it does not exclude it.)
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
